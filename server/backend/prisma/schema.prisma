// Prisma schema for BelfProctor server
// PostgreSQL datasource

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Prisma client generator
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Role {
  ADMIN
  VIEWER
}

enum SystemEventType {
  ProcessStarted
  ProcessStopped
  USBConnected
  USBDisconnected
  NetworkConnection
  NetworkDisconnection
  FileAccess
  RegistryAccess
  PolicyViolation
  SystemError
  AppUsage
}

enum ConfidenceLevel {
  high
  medium
  low
  unknown
}

enum WorkSessionEndReason {
  active
  switch
  app_closed
  timeout
  shutdown
  unknown
}

enum UpdateDeploymentStatus {
  queued
  sent
  downloading
  verifying
  installing
  restarted
  confirmed
  rolled_back
  failed
  already_up_to_date
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  passwordHash String
  role        Role     @default(ADMIN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id                     String    @id // matches ProctorSettings.ClientId
  encryptionKey          String
  category               String?
  hostname               String?
  os                     String?
  version                String?
  lastSeen               DateTime?
  lastHeartbeat          DateTime?
  lastActivity           DateTime?
  lastActivityActiveMs   Int       @default(0)
  lastActivityInactiveMs Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  events                 Event[]
  heartbeats             Heartbeat[]
  screenshots            Screenshot[]
  reports                Report[]
  activities             Activity[]
  workSessions           WorkSession[]
  workEvents             WorkSessionEvent[]
  updateDeployments      UpdateDeployment[]
  appUsages              AppUsage[]
  commandResults         CommandResult[]
  timesheetDays          TimesheetDay[]
  pcSessions             PcSession[]
  browserActivity        BrowserActivity[]
}

model Event {
  id             Int              @id @default(autoincrement())
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  timestamp      DateTime
  eventType      SystemEventType
  description    String?
  details        String?
  processName    String?
  deviceId       String?
  networkAddress String?
  additionalData Json?
  createdAt      DateTime         @default(now())

  @@index([clientId, timestamp])
}

model Heartbeat {
  id        Int      @id @default(autoincrement())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  timestamp DateTime
  status    String
  version   String
  createdAt DateTime @default(now())

  @@index([clientId, timestamp])
}

model Screenshot {
  id        Int      @id @default(autoincrement())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  timestamp DateTime
  filename  String
  path      String
  isFavorite Boolean  @default(false)
  captureReason String?
  linkedSessionId String?
  processName String?
  filePath String?
  projectName String?
  createdAt DateTime @default(now())

  @@index([clientId, timestamp])
}

model WorkSession {
  id              String    @id
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adapter         String
  processName     String
  windowTitle     String?
  filePath        String?
  folderPath      String?
  projectName     String?
  category        String?
  productivityLevel String?
  confidence      ConfidenceLevel @default(unknown)
  openedMs        BigInt    @default(0)
  focusedMs       BigInt    @default(0)
  activeFocusedMs BigInt    @default(0)
  startedAt       DateTime
  endedAt         DateTime?
  endReason       WorkSessionEndReason @default(active)
  lastEventAt     DateTime
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  events          WorkSessionEvent[]

  @@index([clientId, startedAt])
  @@index([projectName, startedAt])
  @@index([processName, startedAt])
  @@index([filePath])
}

model WorkSessionEvent {
  eventId       String   @id
  schemaVersion Int      @default(1)
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessionId     String?
  session       WorkSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  eventType     String
  timestampUtc  DateTime
  adapter       String?
  processName   String?
  windowTitle   String?
  filePath      String?
  folderPath    String?
  projectName   String?
  confidence    ConfidenceLevel @default(unknown)
  payload        Json?
  sourceVersion String?
  receivedAt    DateTime @default(now())

  @@index([clientId, timestampUtc])
  @@index([sessionId])
}

model ProjectRoot {
  id          String   @id
  name        String
  path        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectAlias {
  id          String   @id
  alias       String   @unique
  projectName String
  rootId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UnknownProjectPath {
  id          String   @id
  path        String   @unique
  clientId    String?
  processName String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  seenCount   Int      @default(1)
  resolvedProjectName String?
  ignored     Boolean  @default(false)
}

model AgentVersion {
  version     String   @id
  filename    String
  sha256      String
  size        BigInt
  notes       String?
  uploadedAt  DateTime @default(now())
  deployments UpdateDeployment[]
}

model UpdateDeployment {
  id          String   @id
  version     String
  agentVersion AgentVersion @relation(fields: [version], references: [version], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status      UpdateDeploymentStatus @default(queued)
  detail      String?
  sentAt      DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId, sentAt])
  @@index([version])
  @@index([status])
}

model Report {
  id        Int      @id @default(autoincrement())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  timestamp DateTime
  filename  String
  path      String
  createdAt DateTime @default(now())

  @@index([clientId, timestamp])
}

model Policy {
  id        String   @id
  name      String
  isActive  Boolean  @default(true)
  rules     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id                Int      @id @default(autoincrement())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  timestamp         DateTime
  isActive          Boolean
  activeMilliseconds Int
  inactiveMilliseconds Int @default(0)
  createdAt         DateTime @default(now())

  @@index([clientId, timestamp])
}

model AppUsage {
  id          Int      @id @default(autoincrement())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  processName String
  count       Int      @default(0)
  lastSeen    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientId, processName])
  @@index([clientId, lastSeen])
}

model CommandResult {
  id          Int      @id @default(autoincrement())
  commandId   String
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payload     Json
  receivedAt  DateTime @default(now())

  @@index([commandId, receivedAt])
  @@index([clientId, receivedAt])
}

model TimesheetDay {
  id         Int      @id @default(autoincrement())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  startTime  DateTime?
  endTime    DateTime?
  activeMs   BigInt   @default(0)
  presenceMs BigInt   @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([clientId, date])
}

model PcSession {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bootAt     DateTime
  shutdownAt DateTime?
  // "explicit" — client sent boot/shutdown events
  // "heartbeat_gap" — server inferred from missing heartbeats (>= 10 min)
  // "explicit_with_gap_close" — explicit boot, server-inferred shutdown
  source     String
  bootId     String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([clientId, bootAt])
}

model BrowserActivity {
  id        Int      @id @default(autoincrement())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  url       String
  domain    String
  title     String?
  browser   String
  profile   String?
  visitedAt DateTime
  createdAt DateTime @default(now())

  @@index([clientId, visitedAt])
  @@index([clientId, domain])
  @@unique([clientId, browser, profile, url, visitedAt])
}
