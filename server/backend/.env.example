# ── Runtime ───────────────────────────────────────────────────────────────────
# development | production | test. In production the server REFUSES TO START on
# an insecure/invalid config (weak JWT_SECRET, missing ENCRYPTION_KEY/DATABASE_URL).
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Storage directory (screenshots, reports, logs, etc.)
UPLOAD_DIR=./storage

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production: >= 16 chars, not a known default. Generate a random one.
JWT_SECRET=change_me_long_random_min_16_chars
DEFAULT_ADMIN_EMAIL=admin@local
DEFAULT_ADMIN_PASSWORD=admin12345

# ── Encryption (clients -> server payloads) ──────────────────────────────────
# REQUIRED in production. All pilot clients typically share one key.
ENCRYPTION_KEY=change_me_32+chars_recommended
# Optional: comma-separated list for key rotation / multiple client keys.
# ENCRYPTION_KEYS=key1,key2,key3
# Allow the insecure all-zeros default key in production (NOT recommended; only
# for migrating clients still on the shipped default). Default: off in prod.
# ALLOW_DEFAULT_ENCRYPTION_KEY=0

# ── Database (PostgreSQL / Prisma) ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proctor?schema=public
# Startup connection retry (rides out a Postgres that is still booting).
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_MS=2000

# ── HTTP ──────────────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=10000
# Set to 1 to keep logs on the console only (no rolling files under storage/logs).
# DISABLE_FILE_LOGS=0

# ── Retention (days; AGENT_VERSIONS_KEEP is a count) ─────────────────────────
RETENTION_SCREENSHOTS_DAYS=30
RETENTION_ACTIVITY_DAYS=30
RETENTION_HEARTBEAT_DAYS=2
RETENTION_COMMANDS_DAYS=7
RETENTION_APP_HISTORY_DAYS=30
RETENTION_EVENTS_DAYS=30
RETENTION_BROWSER_DAYS=30
RETENTION_WORK_SESSIONS_DAYS=90
RETENTION_PC_SESSIONS_DAYS=180
RETENTION_TIMESHEET_DAYS=400
RETENTION_REPORTS_DAYS=30
RETENTION_SERVER_LOGS_DAYS=30
RETENTION_CLIENT_LOGS_DAYS=30
RETENTION_AGENT_VERSIONS_KEEP=5

# ── Upload limits (bytes) ────────────────────────────────────────────────────
MAX_SCREENSHOT_BYTES=20971520
MAX_REPORT_BYTES=209715200
MAX_COMMAND_RESULT_BYTES=536870912

# ── Feature flags ─────────────────────────────────────────────────────────────
FEATURE_UPDATE_V2=true
FEATURE_WORK_TRACKING=true
FEATURE_PROJECT_MAPPING=true
FEATURE_LIVE_VIEW=true
FEATURE_RULES_CLASSIFIER=true

# Live View limits
LIVE_VIEW_MAX_STREAMS=10
