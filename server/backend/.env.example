PORT=8080
HOST=0.0.0.0

# Storage directory (screenshots, events, logs, timesheet, etc.)
UPLOAD_DIR=./storage

# Auth
JWT_SECRET=change_me_long_random
DEFAULT_ADMIN_EMAIL=admin@local
DEFAULT_ADMIN_PASSWORD=admin12345

# Encryption (clients -> server payloads)
# Recommended: all clients use the same key for pilot
ENCRYPTION_KEY=change_me_32+chars_recommended
# Optional: comma-separated list if you have multiple client keys during migration
# ENCRYPTION_KEYS=key1,key2,key3

# Retention (days)
RETENTION_SCREENSHOTS_DAYS=30
RETENTION_APP_HISTORY_DAYS=30
RETENTION_COMMANDS_DAYS=7
RETENTION_ACTIVITY_DAYS=30
RETENTION_HEARTBEAT_DAYS=2

# Upload limits (bytes)
MAX_SCREENSHOT_BYTES=20971520
MAX_REPORT_BYTES=209715200
MAX_COMMAND_RESULT_BYTES=536870912

# PostgreSQL / Prisma (primary storage for new structured data)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proctor?schema=public

# Feature flags
FEATURE_UPDATE_V2=true
FEATURE_WORK_TRACKING=true
FEATURE_PROJECT_MAPPING=true
FEATURE_LIVE_VIEW=true
FEATURE_RULES_CLASSIFIER=true

# Live View limits
LIVE_VIEW_MAX_STREAMS=10

# GitHub Releases sync
# Repository with release assets. Example: your-org/belfProctor
GITHUB_RELEASE_REPOSITORY=
# Required for /api/updates/github/webhook signature verification.
GITHUB_WEBHOOK_SECRET=
# Optional for private repositories or higher GitHub API limits.
GITHUB_RELEASE_TOKEN=
# Release asset matchers. Client asset becomes /api/updates/:version/file.
GITHUB_CLIENT_ASSET_REGEX=^BelfProctor(\.|-|_).*\.exe$|^BelfProctor\.exe$
GITHUB_SERVER_ASSET_REGEX=^belfProctor-server\.zip$|^BelfProctor(\.|-|_)Server.*\.zip$
# Keep this off until you intentionally want every new client release deployed.
GITHUB_RELEASE_AUTO_DEPLOY_CLIENT=false
# Server-side scheduled sync. Enable on the LAN production server only.
GITHUB_RELEASE_POLL_ENABLED=false
GITHUB_RELEASE_POLL_INTERVAL_HOURS=24
GITHUB_RELEASE_POLL_START_DELAY_SECONDS=60
# Queue/throttle settings to avoid update spikes.
UPDATE_QUEUE_MAX_PENDING=20
CLIENT_UPDATE_DEPLOY_BATCH_SIZE=10
CLIENT_UPDATE_DEPLOY_BATCH_DELAY_MS=30000
