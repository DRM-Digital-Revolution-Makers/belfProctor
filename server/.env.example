# Copy this file to .env (in the same directory) and fill in the values.
# docker compose automatically loads ./.env for variable substitution.

# --- PostgreSQL ---
POSTGRES_DB=proctor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=4000
JWT_SECRET=change_me_to_a_long_random_string
ENCRYPTION_KEY=change_me_32_chars_min_must_match_clients
DEFAULT_ADMIN_EMAIL=admin@local
DEFAULT_ADMIN_PASSWORD=change_me_strong_password

# --- Frontend ---
FRONTEND_PORT=3000

# --- Retention (days) ---
RETENTION_SCREENSHOTS_DAYS=30
RETENTION_APP_HISTORY_DAYS=30
RETENTION_COMMANDS_DAYS=7
RETENTION_ACTIVITY_DAYS=30
RETENTION_HEARTBEAT_DAYS=2

# --- Upload limits (bytes) ---
MAX_SCREENSHOT_BYTES=20971520
MAX_REPORT_BYTES=209715200
MAX_COMMAND_RESULT_BYTES=536870912

# --- Feature flags ---
FEATURE_UPDATE_V2=true
FEATURE_WORK_TRACKING=true
FEATURE_PROJECT_MAPPING=true
FEATURE_LIVE_VIEW=true
FEATURE_RULES_CLASSIFIER=true
LIVE_VIEW_MAX_STREAMS=10
