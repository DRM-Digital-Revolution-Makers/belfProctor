{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "BelfProctor": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  "ProctorSettings": {
    "ScreenshotInterval": 300000,
    "ScreenshotQuality": 75,
    "ScreenshotPath": "%LOCALAPPDATA%\\BelfProctor\\Screenshots",
    "LogPath": "%LOCALAPPDATA%\\BelfProctor\\Logs",
    "ReportsPath": "%LOCALAPPDATA%\\BelfProctor\\Reports",
    "ServerUrl": "http://169.254.189.111:8080/api",
    "ClientId": "CLIENT02",
    "EncryptionKey": "ABCDEFGHIJKLMNOP",
    "MonitorUSB": true,
    "MonitorProcesses": true,
    "MonitorNetwork": true,
    "AllowedProcesses": [
      "explorer.exe",
      "dwm.exe",
      "winlogon.exe",
      "csrss.exe",
      "smss.exe",
      "services.exe",
      "lsass.exe",
      "svchost.exe"
    ],
    "BlockedProcesses": [
      "cmd.exe",
      "powershell.exe",
      "regedit.exe",
      "taskmgr.exe",
      "msconfig.exe",
      "gpedit.msc"
    ],
    "MaxLogFileSize": 10485760,
    "MaxScreenshotAge": 7,
    "HeartbeatInterval": 60000,
    "PolicyUpdateInterval": 300000
  }
}