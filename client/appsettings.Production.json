{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "BelfProctor": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  "ProctorSettings": {
    "ServerUrl": "http://192.168.2.1:8080/api",
    "ClientId": "CLIENT02",
    "EncryptionKey": "ABCDEFGHIJKLMNOP",
    "ScreenshotIntervalMs": 300000,
    "ScreenshotQuality": 75,
    "ScreenshotPath": "%LOCALAPPDATA%\\BelfProctor\\Screenshots",
    "LogPath": "%LOCALAPPDATA%\\BelfProctor\\Logs",
    "ReportsPath": "%LOCALAPPDATA%\\BelfProctor\\Reports",
    "MonitorUSB": true,
    "MonitorProcesses": true,
    "MonitorNetwork": false,
    "AllowedProcesses": [
      "explorer.exe",
      "dwm.exe",
      "winlogon.exe",
      "csrss.exe",
      "smss.exe",
      "services.exe",
      "lsass.exe",
      "svchost.exe"
    ],
    "BlockedProcesses": [
      "cmd.exe",
      "powershell.exe",
      "regedit.exe",
      "taskmgr.exe",
      "msconfig.exe",
      "gpedit.msc"
    ],
    "MaxLogFileSize": 10485760,
    "MaxScreenshotAge": 7,
    "ScreenshotRetentionMinutes": 60,
    "HeartbeatIntervalMs": 60000,
    "PolicyUpdateIntervalMs": 300000,
    "DirectoryListingIntervalMs": 600000,
    "DirectoryRoots": [
      "%LOCALAPPDATA%\\BelfProctor\\Screenshots",
      "%LOCALAPPDATA%\\BelfProctor\\Logs",
      "%LOCALAPPDATA%\\BelfProctor\\Reports"
    ],
    "Features": {
      "UpdateV2": true,
      "WorkTracking": true,
      "ProjectMapping": true,
      "LiveView": true,
      "RulesClassifier": true
    }
  }
}
