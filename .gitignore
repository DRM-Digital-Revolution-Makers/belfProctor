logs/
**/*.log
*.log
*.tmp
*.temp
*.bak

# Environment files (keep examples)
.env
.env.*
!.env.example
!**/.env.example

# --- .NET / C# (client) ---
**/bin/
**/obj/
**/out/
**/publish/
TestResults/
*.user
*.suo
*.userprefs
*.nupkg

# --- Node / TypeScript (server) ---
# Dependencies
node_modules/

# Build outputs
dist/
coverage/
.nyc_output/

# Zips and big publish files
*.zip
**/publish_win-x64/

# Vite / Next / Nuxt (generic)
.vite/
.next/
.nuxt/
out/

# Prisma generated cache inside node_modules
**/node_modules/.prisma/

# NPM/Yarn/Pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker local artifacts (if any)
*.tar

# Large binaries (exceed GitHub 100MB limit)
client/deploy-pkg/*.exe
client/bootstrap-pkg/*.exe
.codex-tools/